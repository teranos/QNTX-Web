{
  "plugins": ["stylelint-declaration-strict-value"],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      ["/color$/", "background", "background-color", "fill", "stroke", "border-radius", "z-index", "box-shadow", "outline-color"],
      {
        "ignoreValues": ["inherit", "initial", "unset", "none", "transparent", "currentColor", "currentcolor", "auto", "0", "50%", "100%"],
        "disableFix": true,
        "message": "Use a token: var(--...) from tokens.css (found \"${value}\" for ${property})"
      }
    ],
    "declaration-property-value-disallowed-list": {
      "text-overflow": ["/ellipsis/"]
    },
    "declaration-property-value-no-unknown": true,
    "property-no-unknown": true,
    "no-descending-specificity": true,
    "selector-max-id": 0,
    "declaration-no-important": true
  },
  "overrides": [
    { "files": ["css/tokens.css"], "rules": { "scale-unlimited/declaration-strict-value": null } }
  ]
}
