{
  "pairs": [
    "--accent-color on --bg-almost-white",
    "--accent-color on --bg-hover",
    "--accent-color on --bg-primary",
    "--color-error on --bg-almost-black",
    "--color-error on --bg-canvas",
    "--color-error on --bg-dark-light",
    "--color-error on --bg-secondary",
    "--color-error on --bg-tertiary",
    "--color-info on --bg-canvas",
    "--color-info on --bg-dark-light",
    "--color-info on --bg-secondary",
    "--color-info on --bg-tertiary",
    "--status-completed-text on --status-completed-bg",
    "--status-failed-text on --status-failed-bg",
    "--status-paused-text on --status-pending-bg",
    "--status-pending-text on --status-pending-bg",
    "--status-running-text on --status-running-bg",
    "--text-on-dark-tertiary on --bg-canvas",
    "--text-on-dark-tertiary on --bg-dark-light",
    "--text-on-dark-tertiary on --bg-secondary",
    "--text-on-dark-tertiary on --bg-tertiary",
    "--text-tertiary on --bg-almost-white",
    "--text-tertiary on --bg-hover",
    "--text-tertiary on --bg-primary"
  ],
  "rules": [
    "css/canvas.css | .canvas-action-button | color:var(--text-primary) on var(--bg-tertiary)",
    "css/canvas.css | .canvas-action-delete:hover | color:#d45030 on #3d1a0a",
    "css/loading.css | #loader-logs | color:var(--text-secondary) on #0f0f0f",
    "css/panel-base.css | .panel-badge-completed | color:var(--status-completed-text) on var(--status-completed-bg)",
    "css/panel-base.css | .panel-badge-failed | color:var(--status-failed-text) on var(--status-failed-bg)",
    "css/panel-base.css | .panel-badge-paused | color:var(--status-paused-text) on var(--status-pending-bg)",
    "css/panel-base.css | .panel-badge-pending | color:var(--status-pending-text) on var(--status-pending-bg)",
    "css/panel-base.css | .panel-badge-running | color:var(--status-running-text) on var(--status-running-bg)",
    "css/panel-base.css | .panel-badge-stopped | color:var(--status-stopped-text) on var(--bg-almost-white)",
    "css/panel-base.css | .panel-btn-success | color:var(--status-completed-text) on var(--status-completed-bg)",
    "css/panel-base.css | .panel-btn-warning | color:var(--status-pending-text) on var(--status-pending-bg)",
    "css/panel-base.css | .panel-error-inline | color:var(--status-failed-text) on var(--status-failed-bg)",
    "css/panel-base.css | .panel-error-retry | color:#fff on var(--status-failed-text)"
  ]
}
