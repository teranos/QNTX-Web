{
  "pairs": [
    "--color-error on --bg-canvas",
    "--color-error on --bg-dark-light",
    "--color-error on --bg-tertiary",
    "--element-status-error-text on --element-status-error-bg",
    "--status-failed-text on --status-failed-bg",
    "--text-on-dark-tertiary on --bg-canvas",
    "--text-on-dark-tertiary on --bg-dark-light",
    "--text-on-dark-tertiary on --bg-tertiary",
    "--text-tertiary on --bg-almost-white",
    "--text-tertiary on --bg-hover"
  ],
  "rules": [
    "css/canvas.css | .canvas-action-delete:hover | color:#d45030 on #3d1a0a",
    "css/panel-base.css | .panel-badge-failed | color:var(--status-failed-text) on var(--status-failed-bg)",
    "css/panel-base.css | .panel-badge-stopped | color:var(--status-stopped-text) on var(--bg-almost-white)",
    "css/panel-base.css | .panel-error-inline | color:var(--status-failed-text) on var(--status-failed-bg)",
    "css/panel-base.css | .panel-error-retry | color:#fff on var(--status-failed-text)"
  ]
}
